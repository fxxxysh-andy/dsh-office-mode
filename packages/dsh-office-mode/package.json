{
  "name": "dsh-office-mode",
  "version": "0.1.0",
  "private": true,
  "description": "办公模式：极简工具面 + 批量执行 + 零依赖 Word/Excel/PPT 引擎。Office mode for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:suites": "node scripts/run-suites.mjs",
    "test:memory": "node test/memory.mjs",
    "test:memory-recall": "node test/memory-recall.mjs",
    "test:pdf": "node test/pdf.mjs",
    "test:python": "node test/python.mjs",
    "test:view": "node test/view.mjs",
    "test:tex": "node test/format-tex.mjs",
    "test:word": "node test/format-word.mjs",
    "test:excel": "node test/format-excel.mjs",
    "test:ppt": "node test/format-ppt.mjs",
    "test:ppt-math": "node test/format-ppt-math.mjs",
    "test:ppt-revise": "node test/format-ppt-revise.mjs",
    "test:search": "node test/search.mjs",
    "test:web": "node test/web.mjs",
    "test:web-verify": "node test/web-verify.mjs",
    "test:web-proxy": "node test/web-proxy.mjs",
    "test:web-live": "node test/web-live.mjs",
    "test:sites": "node test/site-catalog.mjs",
    "test:seam": "node test/subagent-seam.mjs",
    "test:settings": "node test/settings.mjs",
    "test:client": "node test/client.mjs",
    "test:preset": "node test/preset-check.mjs",
    "test:budget": "node test/injection-budget.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:av": "node test/av.mjs",
    "test:plain": "node test/plain-default.mjs",
    "migrate:mnemon": "node scripts/migrate-mnemon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
